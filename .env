# This file contains the environment variables for the application

# Environment
NODE_ENV=production

# Port for the server
SERVER_PORT=3210

# Secret key for JWT (you can generate one with `openssl rand -hex 32` in the terminal)
JWT_SECRET=dummy

# Session store
REDIS_URL=redis://connection_string:port

# Secret key for sessions (you can generate one with `openssl rand -hex 32` in the terminal)
SESSION_SECRET=dummy

# Logging
LOG_SEQUELIZE=false
LOG_HOOK_EVENTS=false
