<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <% if (layoutType === "login") { %>
    <%- body %>
    <% } else { %>
    <div class="grid grid-cols-[240px_1fr] grid-rows-[64px_1fr] h-screen">
      <%- include("partials/topbar") %> <%- include("partials/menu") %>
      <div class="relative overflow-y-hidden bg-zinc-100">
        <div class="overflow-y-auto">
          <%- include("partials/content", { layoutType }) %>
        </div>
        <% if (locals.settings?.active) { %>
          <% const { title, partial } = settings; %>
          <%-
            include('./components/drawer', {
              formID,
              title,
              component: {
                partial,
                props: {
                  ...data,
                },
              },
            })
          %>
        <% } %>

        <%-
          // TODO: Implement dialog component
          // include('../components/dialog', {
          //   id: formID,
          //   title: "Page Settings",
          //   component: {
          //     partial: "page",
          //     props: {
          //       ...data,
          //     },
          //   },
          // })
        %>
      </div>
    </div>
    <% } %>
    <script type="module" src="/js/app.js"></script>
  </body>
</html>
