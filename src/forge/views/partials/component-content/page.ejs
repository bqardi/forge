<%
  // Optional props
  const { } = locals;
%>

<div
  data-component-content="<%= formID %>"
  class="p-8 flex flex-wrap gap-3.5"
>
  <%-
    include("../../components/form/select", {
      classname: "shrink",
      label: "Type",
      id: "type",
      name: "type",
      values: types || [],
      selected: type || "",
      attributes: [
        `form=${formID}`,
      ],
    })
  %>
  <%-
    include("../../components/form/input", {
      classname: "shrink",
      label: "Slug",
      type: "text",
      id: "slug",
      name: "slug",
      value: data.slug || "",
      attributes: [
        "placeholder=Slug",
        `form=${formID}`,
      ],
    })
  %>
  <%-
    include("../../components/form/select", {
      classname: "shrink",
      label: "Status",
      id: "status",
      name: "status",
      values: [
        {key: "draft", value: "Draft"},
        {key: "published", value: "Published"}
      ],
      selected: data.status || "draft",
      attributes: [
        `form=${formID}`,
      ],
    })
  %>
</div>
