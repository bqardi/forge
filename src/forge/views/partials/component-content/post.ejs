<%
  // Optional props
  const { } = locals;
%>

<div data-component-content="<%= formID %>">
  <div class="p-8 flex flex-wrap gap-3.5">
    <%-
      include("../../components/form/select", {
        classname: "shrink",
        label: "Status",
        id: "status",
        name: "status",
        values: [
          {key: "draft", value: "Draft"},
          {key: "published", value: "Published"}
        ],
        selected: data.status || "draft",
        attributes: [
          `form=${formID}`,
        ],
      })
    %>
  </div>
  <div class="p-8 flex flex-wrap gap-3.5">
    <%-
      include("../../components/button", {
        name: "deleter",
        id: "deleter",
        value: id,
        form: formID,
        label: "Delete",
        variation: "danger",
        attributes: [
          "data-operation=delete",
          "type=button",
        ],
      })
    %>
  </div>
</div>
