<%
  // Optional props
  const { parent } = locals;

  const contentManagement = [
    { href: "/forge/posts", label: "Posts", icon: "posts", page: "posts" },
    { href: "/forge/pages", label: "Pages", icon: "pages", page: "pages" },
    { href: "/forge/media", label: "Media", icon: "media", page: "media" },
  ];
  const configuration = [
    { href: "/forge/appearance", label: "Appearance", icon: "appearance", page: "appearance", child: "themes" },
    { href: "/forge/plugins", label: "Plugins", icon: "plugins", page: "plugins", child: "installed" },
    { href: "/forge/users", label: "Users", icon: "users", page: "users" },
    { href: "/forge/settings", label: "Settings", icon: "settings", page: "settings", child: "general" },
  ];
  const childPages = [
    { href: "/forge/appearance/themes", label: "Themes", icon: "themes", page: "themes", parent: "appearance" },
    { href: "/forge/settings/general", label: "General", icon: "general", page: "general", parent: "settings" },
    { href: "/forge/plugins/installed", label: "Installed plugins", icon: "general", page: "installed", parent: "plugins" },
    { href: "/forge/plugins/browse", label: "Browse plugins", icon: "general", page: "browse", parent: "plugins" },
    { href: "/forge/plugins/upload", label: "Upload plugins", icon: "general", page: "upload", parent: "plugins" },
  ];
%>

<div class="bg-zinc-800 text-white py-5 px-2 hidden [&.active]:block <%= parent ? '' : 'active' %>" data-pages="main">
  <%- include("../partials/menu-button", {
    isActive: page === "dashboard",
    href: "/forge",
    label: "Dashboard",
    icon: "dashboard",
    classname: "mb-8"
  }) %>
  <h2 class="text-lg font-semibold px-3 mb-5">Content management</h2>
  <ul class="mb-8 flex flex-col gap-1.5">
    <%
      for (const link of contentManagement) {
        const href = link.child ? link.href + '/' + link.child : link.href;
    %>
    <li>
      <%- include("../partials/menu-button", {
        child: link.child,
        isActive: link.page === page,
        href,
        label: link.label,
        icon: link.icon
      }) %>
    </li>
    <% } %>
  </ul>

  <h2 class="text-lg font-semibold px-3 mb-5">Configuration</h2>
  <ul class="flex flex-col gap-1.5">
    <%
      for (const link of configuration) {
        const href = link.child ? link.href + '/' + link.child : link.href;
    %>
    <li>
      <%- include("../partials/menu-button", {
        child: link.child,
        isActive: link.page === page,
        href,
        label: link.label,
        icon: link.icon
      }) %>
    </li>
    <% } %>
  </ul>
</div>

<div class="bg-zinc-800 text-white py-5 px-2 hidden [&.active]:block <%= parent ? 'active' : '' %>" data-pages="child">
  <a
    class="flex items-center gap-2 mb-8 text-zinc-400 hover:text-white hover:bg-zinc-700 px-3.5 py-2 rounded-md [&.active]:cursor-default [&.active]:text-white [&.active]:bg-amber-800 <%= page === "dashboard" && "active" %>"
    href="/forge"
  >
    <%- include("../components/icon", {icon: "dashboard"}) %>Dashboard
  </a>

  <h2 class="text-lg font-semibold px-3 mb-5" data-title>
    <% if (parent) { %>
      <a
        href="<%= parent.link %>"
        class="flex items-center gap-2"
      >
        <%- include("../components/icon", {icon: "chevronLeft"}) %> <%= parent.title %>
      </a>
    <% } %>
  </h2>
  <ul class="flex flex-col gap-1.5">
    <% for (const link of childPages) { %>
      <% if (link.parent === parent?.page) { %>
        <li>
          <%- include("../partials/menu-button", {
            child: link.child,
            isActive: link.page === page,
            href: link.href,
            label: link.label,
            icon: link.icon
          }) %>
        </li>
      <% } %>
    <% } %>
  </ul>
</div>
