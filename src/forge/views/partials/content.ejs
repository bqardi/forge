  </div>
<% } %>

<% if (layoutType === "overview") { %>
  <div class="p-5">
    <%- body %>
  </div>
<% } %>

<% if (layoutType === "media") { %>
  <div class="p-5">
    <%- body %>
  </div>
<% } %>

<% if (layoutType === "appearance") { %>
