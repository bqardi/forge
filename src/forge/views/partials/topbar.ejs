<div
  class="col-span-2 bg-zinc-800 text-white px-5 py-2 flex items-center justify-between"
>
  <div class="flex items-center gap-5">
    <a href="<%= config.BASE_URL %>forge" class="text-3xl font-semibold hover:text-amber-600 transition mb-1.5">Forge</a>
    <a
      href="<%= config.BASE_URL %>"
      class="hover:bg-zinc-700 px-3.5 py-2 rounded-md cursor-pointer flex items-center gap-2"
      target="_blank"
    >
      <%- include('../components/icon', {
        icon: 'public'
      }) %>
      Visit the frontend</a>
  </div>
  <div class="flex items-center gap-2">
    <button
      href="/logout"
      class="hover:bg-zinc-700 px-3.5 py-2 rounded-md cursor-pointer flex items-center gap-2"
      data-logout-button
    ><%- include('../components/icon', {
      icon: 'logout'
    }) %>Logout</button>
    <button
      class="rounded-full w-12 h-12 bg-amber-700 hover:bg-amber-800 cursor-pointer"
    >
      SS
    </button>
  </div>
</div>
