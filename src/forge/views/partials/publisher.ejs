<%
  const publishedAt = new Date(data.publishedAt).toLocaleDateString();
  const draftClass = data.status === "draft" ? "text-zinc-400" : "";
  const publishedClass = data.status === "published" ? "text-green-600" : "";
%>

<div>
  <h2 class="text-xl mb-2"><%= publisher.title %></h2>
  <div class="mb-3.5">
    <p class="text-sm">
      Status:
      <span
        class="font-semibold [&.published]:text-green-600 [&.draft]:text-zinc-400 <%= data.status %>"
        data-status-ui
      ><%= data.statusPropercase %></span>
    </p>
    <p class="text-sm">Published: <span class="font-semibold"><%- publishedAt %></span></p>
  </div>
  <div class="flex justify-end gap-2">
    <% if (publisher.draft) { %>
      <%-
        include("../components/button", {
          label: publisher.draft,
          name: "drafter",
          id: "drafter",
          value: id,
          form: `form-${type}`,
          classname: "grow",
          attributes: [
            "data-status=draft",
            "type=button",
          ],
          variation: "outline",
        })
      %>
    <% } %>
    <%-
      include("../components/button", {
        label: publisher.publish,
        name: "publisher",
        id: "publisher",
        value: id,
        form: `form-${type}`,
        classname: "grow",
        attributes: [
          "data-status=published",
          "type=button",
        ],
      })
    %>
  </div>
</div>
