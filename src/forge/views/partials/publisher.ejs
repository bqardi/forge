<% 
  const draftClass = data.status === "Draft" ? "text-zinc-400" : "";
  const publishedClass = data.status === "Published" ? "text-green-600" : "";
%>

<div>
  <h2 class="text-xl mb-2">Publish Page</h2>
  <div class="mb-3.5">
    <p class="text-sm">
      Status:
      <span
        class="font-semibold <%= draftClass + publishedClass %>"
      ><%= data.status %></span>
    </p>
    <p class="text-sm">Published: <span class="font-semibold"><%- data.publishedAt %></span></p>
  </div>
  <div class="flex justify-end">
    <%-
      include("../components/button", {
        label: id === "create" ? "Create" : "Update",
        name: "publisher",
        value: id,
        form: `form-${type}`,
      })
    %>
  </div>
</div>
