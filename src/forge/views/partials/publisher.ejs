<%
  const publishedAt = new Date(data.publishedAt).toLocaleDateString();
  const draftClass = data.status === "draft" ? "text-zinc-400" : "";
  const publishedClass = data.status === "published" ? "text-green-600" : "";
%>

<div>
  <h2 class="text-xl mb-2">Publish Page</h2>
  <div class="mb-3.5">
    <p class="text-sm">
      Status:
      <span
        class="font-semibold <%= draftClass + publishedClass %>"
      ><%= data.statusPropercase %></span>
    </p>
    <p class="text-sm">Published: <span class="font-semibold"><%- publishedAt %></span></p>
  </div>
  <div class="flex justify-end gap-2">
    <%-
      include("../components/button", {
        label: "Draft",
        name: "drafter",
        id: "drafter",
        value: id,
        form: `form-${type}`,
        classname: "grow",
        attributes: [
          "data-status=draft",
          "type=button",
        ],
        variation: "outline",
      })
    %>
    <%-
      include("../components/button", {
        label: id === "create" || data.status === "draft" ? "Publish" : "Update",
        name: "publisher",
        id: "publisher",
        value: id,
        form: `form-${type}`,
        classname: "grow",
        attributes: [
          "data-status=published",
          "type=button",
        ],
      })
    %>
  </div>
</div>
