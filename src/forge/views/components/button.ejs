<%
  // Optional props
  const { attributes = [], classname, value, form, id, name, selector, variation = "default" } = locals;
  const variations = {
    default: "bg-amber-700 hover:bg-amber-800 text-white",
    outline: "border border-amber-700 text-amber-700 hover:bg-amber-800 hover:text-white",
  }
%>

<button
  class="<%= classname %> <%= variations[variation] %> py-2 px-5 rounded-md cursor-pointer"
  <%= id ? `id=${id}` : '' %>
  <%= name ? `name=${name}` : '' %>
  <%= value ? `value=${value}` : '' %>
  <%= form ? `form=${form}` : '' %>
  <%= selector ? `data-${selector}` : '' %>
  <%- attributes.join(' ') %>
>
  <%= label %>
</button>
