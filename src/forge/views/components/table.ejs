<table class="min-w-full bg-white border-collapse">
  <thead>
    <tr>
      <% columns.forEach(column => { %>
      <th class="text-left py-2 px-4 border-b border-gray-200"><%- column.name %></th>
      <% }) %>
    </tr>
  </thead>
  <tbody>
    <% data.forEach(item => { %>
    <tr class="border-b border-gray-200">
      <% columns.forEach(column => { %>
      <td class="py-2 px-4">
        <%- item[column.key] %>
      </td>
      <% }) %>
    </tr>
    <% }) %>
  </tbody>
</table>