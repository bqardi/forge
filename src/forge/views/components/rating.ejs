<%
  // Optional props
  const { value = 0, form, id, name, selector, classname } = locals;
%>
<div class="<%= classname %>"<%= selector ? ` data-${selector}` : '' %>>
  <div class="flex items-center">
    <% for (let i = 1; i <= 5; i++) { %>
      <button
        class="<%= selector ? 'cursor-pointer ' : '' %><%= i <= value ? 'text-yellow-500' : 'text-gray-300' %>"
        data-value="<%= i %>"
        aria-label="<%= i %> star"
      >
        <svg
          class="w-8 h-8 pointer-events-none"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.97a1 1 0 00.95.69h4.18c.969 0 1.371 1.24.588 1.81l-3.39 2.46a1 1 0 00-.364 1.118l1.287 3.97c.3.921-.755 1.688-1.54 1.118l-3.39-2.46a1 1 0 00-1.175 0l-3.39 2.46c-.784.57-1.838-.197-1.54-1.118l1.287-3.97a1 1 0 00-.364-1.118L2.34 9.397c-.783-.57-.38-1.81.588-1.81h4.18a1 1 0 00.95-.69l1.286-3.97z"></path>
        </svg>
      </button>
    <% } %>
  </div>
  <input
    type="hidden"
    <%= id ? `id=${id}` : '' %>
    <%= name ? `name=${name}` : '' %>
    <%= value ? `value=${value}` : '' %>
  >
</div>
