<%
  // Optional props
  const { attributes = [], classname } = locals;
%>

<button
  class="<%= classname ? classname + ' ' : '' %>w-12 h-12 flex items-center justify-center rounded-full cursor-pointer"
  <%- attributes.join(' ') %>
>
  <%- include('./icon', {
    icon
  }) %>
  <span class="sr-only"><%= label %></span>
</button>
