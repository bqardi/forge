<%
  // Optional props
  const { onclick, value, form, id, name, attributes = [], classname } = locals;
%>

<button
  class="<%= classname ? classname + ' ' : '' %>w-12 h-12 grid place-content-center rounded-full cursor-pointer"
  <%= id ? `id=${id}` : '' %>
  <%= name ? `name=${name}` : '' %>
  <%= value ? `value=${value}` : '' %>
  <%= form ? `form=${form}` : '' %>
  <%= attributes.join(' ') %>
>
  <%- include('./icon', {
    icon
  }) %>
  <span class="sr-only"><%= label %></span>
</button>
