<%
  // Optional props
  const { classname, label, value, attributes = [] } = locals;
%>

<div class="<%= classname %>">
  <label for="<%= id %>" class="block text-sm font-medium text-gray-700"><%= label %></label>
  <input
    type="<%= type %>"
    id="<%= id %>"
    name="<%= name %>"
    value="<%= value %>"
    class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm focus-visible:outline-none focus-visible:ring-indigo-500 focus-visible:border-indigo-500 sm:text-sm"
    <%= attributes.join(' ') %>
  />
</div>