<%
  const createdAt = new Date(data.createdAt).toLocaleDateString();
%>

<div data-user>
  <h1 class="page-title">User (<%= data.username %>)</h1>
  <p>Created at <%= createdAt %></p>
  
  <form class="mt-5" id="<%= formID %>">
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "id",
        name: "id",
        value: data.id,
      })
    %>
    <%-
      include("../components/form/input", {
        classname: id === "create" ? "mb-8" : "hidden",
        label: "Username",
        type: "text",
        id: "username",
        name: "username",
        value: data.username,
        attributes: [
          "placeholder=Username",
          "required",
          `data-required="Username is required"`,
        ],
      })
    %>
    <%-
      include("../components/form/input", {
        classname: id === "create" ? "mb-8" : "hidden",
        label: "Email",
        type: "email",
        id: "email",
        name: "email",
        value: data.email,
        attributes: [
          "placeholder=Email",
        ],
      })
    %>
    <%-
      include("../components/form/input-password", {
        classname: "mb-8",
        label: id === "create" ? "Password" : "Change password",
        id: "password",
        name: "password",
        attributes: [
          "placeholder=Password",
        ],
      })
    %>
  </form>
</div>
