<div>
  <div class="flex justify-between items-start">
    <div>
      <h1 class="page-title">Posts</h1>
      <p>This is the posts <%= layoutType %></p>
    </div>
    <a
      class="bg-amber-700 hover:bg-amber-800 text-white py-2 px-5 rounded-md"
      href="/forge/posts/create"
    >New post</a>
  </div>

  <div class="mt-5 overflow-hidden border border-gray-300 rounded-md">
    <%-
      include('../components/table', {
        data: data.posts.map((post) => {
          return {
            ...post,
            title: `<a href="/forge/posts/${post.id}" class="link">${post.title}</a>`,
            authorName: data.user.username,
            createdAt: new Date(post.createdAt).toLocaleDateString()
          }
        }),
        columns: [
          {name: "Title", key: "title"},
          {name: "Link", key: "slug"},
          {name: "Author", key: "authorName"},
          {name: "Date created", key: "createdAt"},
        ]
      })
    %>
  </div>
</div>
