<%
  const createdAt = new Date(data.createdAt).toLocaleDateString();
%>

<div>
  <h1 class="page-title">Post</h1>
  <p>This is a single post <%= layoutType %></p>

  <form class="mt-5" id="form-post">
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "id",
        name: "id",
        value: data.id,
      })
    %>
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "authorId",
        name: "authorId",
        value: data.user.id,
      })
    %>
    <%-
      include("../components/form/input", {
        classname: "mb-8",
        label: "Title",
        type: "text",
        id: "title",
        name: "title",
        value: data.title,
        attributes: [
          "placeholder=Title",
          "required",
          `data-required="Title is required"`,
        ],
      })
    %>
  </form>
</div>
