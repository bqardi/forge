<%
  const createdAt = new Date(data.createdAt).toLocaleDateString();
  const slugURL = data.slug && GET_URL(data.slug);
%>

<div data-page>  
  <div class="flex justify-between items-start">
    <div>
      <h1 class="page-title">Page</h1>
      <p>
        Link:
        <a
          class="link"
          href="<%- slugURL %>"
          target="_blank"
          data-base-url="<%= GET_URL('/') %>"
        ><%- slugURL %></a>
      </p>
    </div>
  </div>

  <form class="mt-5" id="<%= formID %>">
    <input type="hidden" name="publishedAt" value="<%= data.publishedAt %>" />
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "id",
        name: "id",
        value: data.id,
      })
    %>
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "authorId",
        name: "authorId",
        value: data.user.id,
      })
    %>
    <%-
      include("../components/form/input", {
        classname: "grow basis-2/3",
        label: "Title",
        type: "text",
        id: "title",
        name: "title",
        value: data.title || "",
        attributes: [
          "placeholder=Title",
          "required",
          `data-required="Title is required"`,
        ],
      })
    %>
  </form>
</div>
