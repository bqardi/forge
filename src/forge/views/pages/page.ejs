<%
  const createdAt = new Date(data.createdAt).toLocaleDateString();
%>

<div data-page>  
  <div class="flex justify-between items-start">
    <div>
      <h1 class="page-title">Page</h1>
      <p>
        Link:
        <a
          class="link"
          href="<%= GET_URL(data.slug) %>"
          target="_blank"
          data-base-url="<%= GET_URL('/') %>"
        ><%= GET_URL(data.slug) %></a>
      </p>
    </div>
    <%- include('../components/icon-button',{
      icon: "settings",
      label: "Settings",
      classname: "hover:bg-zinc-200",
      attributes: [
        `data-dialog-trigger=${formID}`,
      ],
    }) %>
  </div>

  <form class="mt-5" id="<%= formID %>">
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "id",
        name: "id",
        value: data.id,
      })
    %>
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "authorId",
        name: "authorId",
        value: data.user.id,
      })
    %>
    <div class="flex max-lg:flex-wrap gap-x-4">
      <%-
        include("../components/form/input", {
          classname: "mb-4 grow basis-2/3",
          label: "Title",
          type: "text",
          id: "title",
          name: "title",
          value: data.title || "",
        })
      %>
      <%-
        include("../components/form/input", {
          classname: "mb-4 grow basis-1/3",
          label: "Slug",
          type: "text",
          id: "slug",
          name: "slug",
          value: data.slug || "",
        })
      %>
    </div>
  </form>
</div>
