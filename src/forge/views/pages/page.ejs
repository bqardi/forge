<%
  const createdAt = new Date(data.createdAt).toLocaleDateString();
%>

<div data-page>  
  <div class="flex justify-between items-start">
    <div>
      <h1 class="page-title">Page</h1>
      <p>
        Link:
        <a
          class="link"
          href="<%= GET_URL(data.slug) %>"
          target="_blank"
          data-base-url="<%= GET_URL('/') %>"
        ><%= GET_URL(data.slug) %></a>
      </p>
    </div>
  </div>

  <form class="mt-5" id="<%= formID %>">
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "id",
        name: "id",
        value: data.id,
      })
    %>
    <%-
      include("../components/form/input", {
        type: "hidden",
        id: "authorId",
        name: "authorId",
        value: data.user.id,
      })
    %>
    <div class="mb-8 flex max-lg:flex-wrap gap-x-4">
      <%-
        include("../components/form/input", {
          classname: "grow basis-2/3",
          label: "Title",
          type: "text",
          id: "title",
          name: "title",
          value: data.title || "",
          attributes: [
            "placeholder=Title",
            "required",
            `data-required="Title is required"`,
          ],
        })
      %>
      <%-
        include("../components/form/input", {
          classname: "grow basis-1/3",
          label: "Slug",
          type: "text",
          id: "slug",
          name: "slug",
          value: data.slug || "",
          attributes: [
            "placeholder=Slug",
            "required",
            `data-required="Slug is required"`,
          ],
        })
      %>
    </div>
  </form>
</div>
