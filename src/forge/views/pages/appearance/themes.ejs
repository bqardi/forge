<div class="lg:col-span-2 xl:col-span-3">
  <h1 class="page-title">Themes</h1>
  <p>This is the themes <%= layoutType %></p>
</div>

<% data.themes.forEach((theme, index) => { %>
  <div class="border shadow-md rounded-md grid grid-cols-[2fr_1fr]">
    <div class="p-5">
      <div class="flex items-start justify-between gap-3.5">
        <div>
          <h2 class="text-xl font-semibold"><%= theme.title %></h2>
        <p class="text-zinc-700 mb-3"><%= theme.description %></p>
        </div>
        <%- include('../../components/form/toggle', {
          label: 'Edit',
          hideLabel: true,
          selector: `theme=${theme.name}`,
          checked: theme.isActive,
        }) %>
      </div>
      <%- include('../../components/rating', {
        value: theme.rating,
      }) %>
    </div>
    <div>
      <img
        src="https://picsum.photos/400/280/?random=<%= index %>"
        alt="<%= theme.title %> theme"
        class="object-cover w-full h-full"
      >
    </div>
  </div>
<% }); %>
