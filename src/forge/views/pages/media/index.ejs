
<div class="flex justify-between items-start mb-8">
  <div>
    <h1 class="page-title">Media</h1>
    <p>This is the media</p>
  </div>
  <form
    action="/api/media"
    method="post"
    enctype="multipart/form-data"
    class=""
    data-upload-form
  >
    <label for="file-upload" class="inline-block bg-amber-700 hover:bg-amber-800 text-white py-2 px-5 rounded-md cursor-pointer">Upload file...</label>
    <input class="sr-only" id="file-upload" type="file" name="upload" />
  </form>
</div>

<div>
  <h2 class="text-xl font-bold"><%= data.title %></h2>
  <ul class="grid grid-cols-6 gap-3.5">
    <% data.fileList.forEach((file) => { %>
      <li class="group rounded-md overflow-hidden">
        <button
          class="cursor-pointer w-full h-full flex items-center justify-between"
          data-media-name="<%= file.name %>"
          data-media-size="<%= file.size %>"
          data-media-mime="<%= file.mimeType %>"
        >
          <% if (file.type === 'image') { %>
            <img class="group-hover:scale-105 transition-transform aspect-square w-full h-full object-cover" src="<%= file.url %>" alt="<%= file.name %>">
          <% } else { %>
            <div class="transition flex items-center justify-center w-full h-full bg-zinc-200 group-hover:bg-zinc-300 text-zinc-700 group-hover:text-zinc-900">
              <%- include('../../components/icon', {
                icon: "media",
                attributes: [`class="size-16"`],
              }) %>
            </div>
          <% } %>
        </button>
      </li>
    <% }) %>
  </ul>
</div>
