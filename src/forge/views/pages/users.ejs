<div>
  <h1 class="page-title">Users</h1>
  <p>This is the users <%= layoutType %></p>

  <div class="mt-5 overflow-hidden border border-gray-300 rounded-md">
    <%- 
      include("../components/table", {
        data: users.map((user) => {
          const details = user.dataValues;
          return {
            ...details,
            username: `<a href="/forge/users/${details.id}" class="link">${details.username}</a>`,
            email: `<a href="mailto:${details.email}" class="link">${details.email}</a>`,
            createdAt: new Date(details.createdAt).toLocaleDateString()
          }
        }),
        columns: [
          {name: "Username", key: "username"},
          {name: "Email", key: "email"},
          {name: "Date created", key: "createdAt"},
        ]
      })
    %>
</div>
