{
  "name": "forge-dashboard",
  "version": "1.0.0",
  "description": "Forge admin dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:js\"",
    "dev:css": "npx @tailwindcss/cli -i ./src/css/style.css -o ./assets/css/style.css --watch",
    "dev:js": "webpack --watch",
    "build": "npx @tailwindcss/cli -i ./src/css/style.css -o ./assets/css/style.css && webpack"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
